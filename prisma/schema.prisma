generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String?
  bio          String?
  avatarUrl    String?
  themeColor   String   @default("amber")
  themeMode    String   @default("dark")
  createdAt    DateTime @default(now())

  isPrivate          Boolean @default(false)
  dmPrivacy          String  @default("everyone") // everyone | followers | none
  notifyOnFollow     Boolean @default(true)
  notifyOnLike       Boolean @default(true)
  notifyOnComment    Boolean @default(true)
  notifyOnMessage    Boolean @default(true)
  emailNotifications Boolean @default(true)

  logs         Log[]
  comments     Comment[]
  likes        Like[]
  fiveFaves    FiveFave[]
  trackRatings TrackRating[]
  rankedLists  RankedList[]

  following Follow[] @relation("follower")
  followers Follow[] @relation("following")

  sentMessages     Message[] @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")

  notifications      Notification[] @relation("notifUser")
  notificationsCaused Notification[] @relation("notifActor")
}

model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Artist {
  id             String  @id @default(cuid())
  name           String
  imageUrl       String?
  spotifyId      String? @unique
  discogsId      String? @unique
  musicbrainzId  String? @unique
  albums         Album[]
}

model Genre {
  id     String       @id @default(cuid())
  name   String       @unique
  albums AlbumGenre[]
}

model AlbumGenre {
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  @@id([albumId, genreId])
}

model Album {
  id                String    @id @default(cuid())
  title             String
  coverUrl          String?
  releaseDate       DateTime?
  releaseGroupType  String    @default("Album")
  artist            Artist    @relation(fields: [artistId], references: [id])
  artistId          String
  spotifyId         String?   @unique
  discogsId         String?   @unique
  musicbrainzId     String?   @unique
  createdAt         DateTime  @default(now())

  tracks    Track[]
  credits   Credit[]
  genres    AlbumGenre[]
  logs      Log[]
  fiveFaves FiveFave[]
  rankedListItems RankedListItem[]
  sharedInMessages Message[]

  @@index([artistId])
  @@index([title])
}

model Track {
  id            String  @id @default(cuid())
  title         String
  trackNumber   Int
  durationSec   Int?
  musicbrainzId String?
  album         Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId       String

  ratings TrackRating[]

  @@index([albumId])
  @@index([musicbrainzId])
}

model TrackRating {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId   String
  rating    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, trackId])
  @@index([trackId])
}

model Credit {
  id      String @id @default(cuid())
  name    String
  role    String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId String

  @@index([albumId])
  @@index([name])
}

model Log {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId    String
  rating     Float?
  reviewText String?
  listenedAt DateTime @default(now())
  isRelisten Boolean  @default(false)
  createdAt  DateTime @default(now())

  likes    Like[]
  comments Comment[]
  contextTags LogContextTag[]
  sharedInMessages Message[]
  notifications Notification[]

  @@index([userId])
  @@index([albumId])
  @@index([userId, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  log       Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId     String
  createdAt DateTime @default(now())

  @@unique([userId, logId])
  @@index([logId])
}

model Comment {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  log       Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId     String
  text      String
  createdAt DateTime @default(now())

  @@index([logId])
}

model FiveFave {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  album    Album  @relation(fields: [albumId], references: [id])
  albumId  String
  position Int

  @@unique([userId, position])
  @@unique([userId, albumId])
}

model Message {
  id            String    @id @default(cuid())
  sender        User      @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId      String
  recipient     User      @relation("receivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId   String
  text          String?
  sharedAlbum   Album?    @relation(fields: [sharedAlbumId], references: [id], onDelete: SetNull)
  sharedAlbumId String?
  sharedLog     Log?      @relation(fields: [sharedLogId], references: [id], onDelete: SetNull)
  sharedLogId   String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
  @@index([recipientId, readAt])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation("notifUser", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  actor     User?    @relation("notifActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  type      String // follow | like | comment | message
  log       Log?     @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model RankedList {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items RankedListItem[]

  @@index([userId])
}

model RankedListItem {
  id       String     @id @default(cuid())
  list     RankedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId   String
  album    Album      @relation(fields: [albumId], references: [id])
  albumId  String
  position Int
  note     String?

  @@unique([listId, albumId])
  @@index([listId, position])
}

model ContextTag {
  id   String @id @default(cuid())
  name String @unique

  logs LogContextTag[]
}

model LogContextTag {
  log   Log        @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId String
  tag   ContextTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  @@id([logId, tagId])
  @@index([tagId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())

  logs      Log[]
  comments  Comment[]
  likes     Like[]
  fiveFaves FiveFave[]

  following Follow[] @relation("follower")
  followers Follow[] @relation("following")
}

model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Artist {
  id        String  @id @default(cuid())
  name      String
  imageUrl  String?
  spotifyId String? @unique
  discogsId String? @unique
  albums    Album[]
}

model Genre {
  id     String       @id @default(cuid())
  name   String       @unique
  albums AlbumGenre[]
}

model AlbumGenre {
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  @@id([albumId, genreId])
}

model Album {
  id          String    @id @default(cuid())
  title       String
  coverUrl    String?
  releaseDate DateTime?
  artist      Artist    @relation(fields: [artistId], references: [id])
  artistId    String
  spotifyId   String?   @unique
  discogsId   String?   @unique
  createdAt   DateTime  @default(now())

  tracks    Track[]
  credits   Credit[]
  genres    AlbumGenre[]
  logs      Log[]
  fiveFaves FiveFave[]

  @@index([artistId])
  @@index([title])
}

model Track {
  id          String  @id @default(cuid())
  title       String
  trackNumber Int
  durationSec Int?
  album       Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId     String

  @@index([albumId])
}

model Credit {
  id      String @id @default(cuid())
  name    String
  role    String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId String

  @@index([albumId])
}

model Log {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId    String
  rating     Float?
  reviewText String?
  listenedAt DateTime @default(now())
  isRelisten Boolean  @default(false)
  createdAt  DateTime @default(now())

  likes    Like[]
  comments Comment[]

  @@index([userId])
  @@index([albumId])
  @@index([userId, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  log       Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId     String
  createdAt DateTime @default(now())

  @@unique([userId, logId])
  @@index([logId])
}

model Comment {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  log       Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId     String
  text      String
  createdAt DateTime @default(now())

  @@index([logId])
}

model FiveFave {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  album    Album  @relation(fields: [albumId], references: [id])
  albumId  String
  position Int

  @@unique([userId, position])
  @@unique([userId, albumId])
}
